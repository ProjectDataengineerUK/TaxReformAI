# Copie este arquivo para .env e preencha com valores reais.
# .env nunca deve ser commitado (ver .gitignore).

GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GCP_REGION=southamerica-east1

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legislacao_tributaria

PLANALTO_BASE_URL=https://www.planalto.gov.br
DENSE_EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_PARENT_LEVEL=artigo
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# Usado apenas por `uvicorn api.main:app` local (dev do frontend) — não é credencial.
# Em produção, o workflow deploy.yml injeta a URL real do serviço Cloud Run do
# frontend. Se ficar no default, um frontend deployado é bloqueado por CORS.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Mapa chave-de-API -> tenant_id, em JSON. Local, use valores fictícios.
# Em produção vive no GitHub Secret API_KEYS e é injetado pelo deploy.yml.
# Sem esta variável a API sobe respondendo 401 para tudo (o smoke test pega).
# O tenant_id aqui precisa bater com o tenant_id enviado no corpo de
# POST /v1/tax/simulate, senão a resposta é 403.
API_KEYS={"chave-local-de-teste":"tenant-local"}
