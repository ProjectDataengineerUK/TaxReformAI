# Copie este arquivo para .env e preencha com valores reais.
# .env nunca deve ser commitado (ver .gitignore).

GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GCP_REGION=southamerica-east1

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legislacao_tributaria

PLANALTO_BASE_URL=https://www.planalto.gov.br
DENSE_EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_PARENT_LEVEL=artigo
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

# Usado apenas por `uvicorn api.main:app` local (dev do frontend) — não é credencial.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
